---
// Social proof placeholder — trust signals and avatar row
---

<section class="bg-cream-100 dark:bg-warm-800/50 border-y border-warm-200/60 dark:border-warm-700/40 py-10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-8">

      <!-- Avatar row + count -->
      <div class="flex items-center gap-4">
        <div class="flex -space-x-3">
          <!-- Avatar placeholders with initials -->
          {["S", "M", "A", "J", "R"].map((initial, i) => (
            <div
              class="w-10 h-10 rounded-full border-2 border-cream-50 dark:border-warm-800 flex items-center justify-center text-sm font-semibold text-white shadow-sm"
              style={`background: ${["#E8704A","#5fa07c","#e05528","#8fbfa5","#ae3319"][i]}; z-index: ${5 - i};`}
            >
              {initial}
            </div>
          ))}
        </div>
        <div>
          <p class="text-warm-900 dark:text-cream-100 font-semibold text-sm">
            200+ parents &amp; students
          </p>
          <p class="text-warm-500 dark:text-warm-400 text-xs">already on the waitlist</p>
        </div>
      </div>

      <!-- Divider -->
      <div class="hidden sm:block w-px h-10 bg-warm-200 dark:bg-warm-700"></div>

      <!-- Trust badges -->
      <div class="flex flex-wrap items-center justify-center gap-6">
        <div class="flex items-center gap-2 text-sm text-warm-600 dark:text-warm-400">
          <div class="w-8 h-8 rounded-lg bg-sage-100 dark:bg-sage-700/30 flex items-center justify-center">
            <svg class="w-4 h-4 text-sage-600 dark:text-sage-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd"/>
            </svg>
          </div>
          <span>On-device AI, privacy first</span>
        </div>

        <div class="flex items-center gap-2 text-sm text-warm-600 dark:text-warm-400">
          <div class="w-8 h-8 rounded-lg bg-milo-50 dark:bg-milo-900/30 flex items-center justify-center">
            <svg class="w-4 h-4 text-milo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5"/>
            </svg>
          </div>
          <span>Built for high school students</span>
        </div>

        <div class="flex items-center gap-2 text-sm text-warm-600 dark:text-warm-400">
          <div class="w-8 h-8 rounded-lg bg-cream-200 dark:bg-warm-700 flex items-center justify-center">
            <span class="text-base leading-none">🍁</span>
          </div>
          <span>Made in Canada</span>
        </div>
      </div>

      <!-- Divider -->
      <div class="hidden sm:block w-px h-10 bg-warm-200 dark:bg-warm-700"></div>

      <!-- Star rating placeholder -->
      <div class="text-center">
        <div class="flex items-center gap-0.5 justify-center mb-1">
          {[1,2,3,4,5].map(() => (
            <svg class="w-4 h-4 text-milo-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        <p class="text-xs text-warm-500 dark:text-warm-400">Beta testers love Milo</p>
      </div>

    </div>
  </div>
</section>
