---
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const apiUrl = import.meta.env.PUBLIC_API_URL;
const isMissingConfig = !siteKey || !apiUrl;
---

{
  isMissingConfig ? (
    <div class="rounded-xl border-2 border-amber-400 bg-amber-50 dark:bg-amber-900/20 dark:border-amber-600 p-6 text-center">
      <p class="text-amber-800 dark:text-amber-300 font-medium">
        ⚠️ Waitlist unavailable — configuration missing.
      </p>
      <p class="text-amber-700 dark:text-amber-400 text-sm mt-1">
        Set <code>PUBLIC_TURNSTILE_SITE_KEY</code> and <code>PUBLIC_API_URL</code> at build time.
      </p>
    </div>
  ) : (
    <div>
      <form
        id="waitlist-form"
        class="flex flex-col gap-4"
        novalidate
      >
        <div>
          <label
            for="email"
            class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1.5"
          >
            Email address
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="you@example.com"
            autocomplete="email"
            class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-milo-400 focus:border-transparent transition"
          />
        </div>

        <!-- Cloudflare Turnstile widget -->
        <div
          class="cf-turnstile"
          data-sitekey={siteKey}
          data-callback="onTurnstileCallback"
          data-error-callback="onTurnstileError"
          data-theme="auto"
        />

        <button
          type="submit"
          id="waitlist-submit"
          class="btn-primary w-full py-3.5 text-base shadow-lg shadow-milo-400/25"
        >
          Join the waitlist
        </button>

        <!-- Status messages -->
        <p
          id="waitlist-error"
          class="hidden text-sm text-red-600 dark:text-red-400 text-center"
          role="alert"
          aria-live="polite"
        />
        <p
          id="waitlist-info"
          class="hidden text-sm text-slate-500 dark:text-slate-400 text-center"
          aria-live="polite"
        />
      </form>

      <script define:vars={{ apiUrl }}>
        // Turnstile token storage
        window.onTurnstileCallback = function (token) {
          window.__turnstileToken = token;
        };

        window.onTurnstileError = function () {
          window.__turnstileToken = null;
          showError(
            "CAPTCHA verification failed. Please refresh the page and try again."
          );
        };

        function showError(msg) {
          const el = document.getElementById("waitlist-error");
          const info = document.getElementById("waitlist-info");
          if (el) {
            el.textContent = msg;
            el.classList.remove("hidden");
          }
          if (info) info.classList.add("hidden");
        }

        function showInfo(msg) {
          const el = document.getElementById("waitlist-info");
          const err = document.getElementById("waitlist-error");
          if (el) {
            el.textContent = msg;
            el.classList.remove("hidden");
          }
          if (err) err.classList.add("hidden");
        }

        function hideMessages() {
          const err = document.getElementById("waitlist-error");
          const info = document.getElementById("waitlist-info");
          if (err) err.classList.add("hidden");
          if (info) info.classList.add("hidden");
        }

        document
          .getElementById("waitlist-form")
          ?.addEventListener("submit", async function (e) {
            e.preventDefault();

            hideMessages();

            const form = e.currentTarget;
            const emailInput = form.querySelector('input[name="email"]');
            const submitBtn = document.getElementById("waitlist-submit");
            const email = emailInput?.value?.trim();

            if (!email) {
              showError("Please enter your email address.");
              emailInput?.focus();
              return;
            }

            const token = window.__turnstileToken;
            if (!token) {
              showError(
                "Please complete the CAPTCHA verification above."
              );
              return;
            }

            // Disable button while submitting
            if (submitBtn) {
              submitBtn.disabled = true;
              submitBtn.textContent = "Joining…";
            }

            try {
              const res = await fetch(`${apiUrl}/waitlist`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email, turnstileToken: token }),
              });

              if (res.ok) {
                window.location.href = "/waitlist-success";
                return;
              }

              // Error handling per status
              if (res.status === 400) {
                showError(
                  "That email address doesn't look right. Please check it and try again."
                );
              } else if (res.status === 403) {
                showError(
                  "CAPTCHA verification failed. Please refresh the page and try again."
                );
              } else if (res.status === 429) {
                showError(
                  "Too many requests — you've already joined, or please try again in a few minutes."
                );
              } else {
                showError(
                  "Something went wrong on our end. Please try again in a moment."
                );
              }
            } catch (_err) {
              showError(
                "Unable to reach the server. Please check your connection and try again."
              );
            } finally {
              if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.textContent = "Join the waitlist";
              }
            }
          });
      </script>
    </div>
  )
}
