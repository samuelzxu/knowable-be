---
// Hero section
---

<section class="relative overflow-hidden bg-white dark:bg-slate-950 py-24 sm:py-32">
  <!-- Background gradient -->
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-milo-50 via-white to-white dark:from-milo-900/20 dark:via-slate-950 dark:to-slate-950"
  >
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 rounded-full bg-milo-50 dark:bg-milo-900/30 border border-milo-200 dark:border-milo-800 px-4 py-1.5 text-sm font-medium text-milo-600 dark:text-milo-400 mb-8">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-milo-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-milo-500"></span>
      </span>
      Early access — join the waitlist
    </div>

    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white leading-tight tracking-tight mb-6">
      The AI coach that<br />
      <span class="text-milo-400">watches you practice</span>
    </h1>

    <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
      Knowable uses macOS Desk View to coach you through math and physics
      problems in real time. Meet <strong class="text-slate-800 dark:text-slate-200">Milo</strong> — your AI tutor.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#waitlist" class="btn-primary text-base px-8 py-3.5 shadow-lg shadow-milo-400/25">
        Join the waitlist
      </a>
      <a href="#features" class="btn-secondary text-base px-8 py-3.5">
        Learn more
      </a>
    </div>
  </div>
</section>
