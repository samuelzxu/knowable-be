---
// Hero section — warm editorial with CSS notebook illustration
---

<section class="relative overflow-hidden bg-cream-50 dark:bg-warm-900 pt-20 pb-16 sm:pt-28 sm:pb-24">

  <!-- Animated background blobs (CSS only) -->
  <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div
      class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full opacity-20 dark:opacity-10"
      style="background: radial-gradient(circle, #E8704A 0%, #f0a383 40%, transparent 70%); animation: float-up-down 8s ease-in-out infinite;"
    ></div>
    <div
      class="absolute -bottom-40 -left-40 w-[500px] h-[500px] rounded-full opacity-10 dark:opacity-5"
      style="background: radial-gradient(circle, #5fa07c 0%, #8fbfa5 40%, transparent 70%); animation: float-up-down 10s ease-in-out infinite reverse;"
    ></div>
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] opacity-[0.04] dark:opacity-[0.06]"
      style="background: radial-gradient(ellipse, #E8704A 0%, transparent 60%);"
    ></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: Text content -->
      <div class="text-center lg:text-left">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 rounded-full bg-milo-50 dark:bg-milo-900/30 border border-milo-200 dark:border-milo-800 px-4 py-1.5 text-sm font-medium text-milo-600 dark:text-milo-400 mb-8">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-milo-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-milo-400"></span>
          </span>
          Early access — apply now
        </div>

        <h1 class="font-display text-5xl sm:text-6xl lg:text-[4.25rem] leading-[1.08] text-warm-900 dark:text-cream-50 mb-6">
          The tutor that<br />
          <em class="not-italic text-milo-400">follows along</em><br />
          <em class="not-italic">as you think.</em>
        </h1>

        <p class="text-lg sm:text-xl text-warm-600 dark:text-warm-400 max-w-lg mx-auto lg:mx-0 mb-10 leading-relaxed">
          Meet <strong class="text-warm-900 dark:text-cream-100 font-semibold">Milo</strong> — an AI coach that sees your actual notebook, notices when you're stuck, and guides you to the answer without ever giving it away.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a href="#waitlist" class="btn-primary text-base px-8 py-4 text-lg">
            Get early access
          </a>
          <a href="#how-it-works" class="btn-secondary text-base px-8 py-4 text-lg">
            See how it works
          </a>
        </div>

        <!-- Mini trust signals -->
        <div class="mt-10 flex flex-wrap items-center justify-center lg:justify-start gap-x-6 gap-y-3 text-sm text-warm-500 dark:text-warm-500">
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-sage-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd"/></svg>
            On-device processing
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-sage-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
            Socratic hints, never answers
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-sage-500" fill="currentColor" viewBox="0 0 20 20"><path d="M10 12.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z"/><path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 010-1.186A10.004 10.004 0 0110 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0110 17c-4.257 0-7.893-2.66-9.336-6.41zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/></svg>
            macOS only — uses your Mac's camera
          </span>
        </div>
      </div>

      <!-- Right: CSS notebook illustration -->
      <div class="relative flex items-center justify-center lg:justify-end" aria-hidden="true">
        <div class="relative w-72 sm:w-80 lg:w-96">

          <!-- Desk surface -->
          <div
            class="relative rounded-3xl overflow-hidden"
            style="
              background: linear-gradient(135deg, #f5e6d3 0%, #fdf0e4 50%, #f5e6d3 100%);
              padding: 28px 24px 24px;
              animation: float-up-down 7s ease-in-out infinite;
              box-shadow: 0 8px 32px rgba(0,0,0,0.10), 0 2px 8px rgba(0,0,0,0.06);
            "
          >
            <!-- Notebook spine accent -->
            <div class="absolute left-0 top-0 bottom-0 w-5 rounded-l-3xl" style="background: #E8704A; opacity: 0.85;"></div>

            <!-- Notebook lines -->
            <div class="ml-4 space-y-3">
              <!-- Title line -->
              <div class="h-6 rounded-md flex items-center">
                <span class="text-xs font-semibold text-warm-700 font-display italic">Physics — Chapter 4</span>
              </div>

              <!-- Math content lines -->
              <div class="space-y-2 pt-1">
                <div class="h-px bg-blue-200/60" style="margin-left: -4px; margin-right: -4px;"></div>
                <div class="flex items-baseline gap-2 text-[11px] text-warm-700" style="font-family: 'Georgia', serif;">
                  <span>F = ma</span>
                  <span class="text-warm-400">→</span>
                  <span>a = F/m</span>
                </div>
                <div class="h-px bg-blue-200/60" style="margin-left: -4px; margin-right: -4px;"></div>
                <div class="text-[11px] text-warm-700" style="font-family: 'Georgia', serif;">
                  m = 5 kg,&nbsp; F = 20 N
                </div>
                <div class="h-px bg-blue-200/60" style="margin-left: -4px; margin-right: -4px;"></div>
                <!-- Student working -->
                <div class="text-[11px] text-warm-600" style="font-family: 'Georgia', serif;">
                  a = 20 / 5 = <span class="text-warm-400">...</span>
                </div>
                <div class="h-px bg-blue-200/60" style="margin-left: -4px; margin-right: -4px;"></div>
                <div class="h-px bg-blue-200/60 mt-2" style="margin-left: -4px; margin-right: -4px;"></div>
                <div class="h-px bg-blue-200/60" style="margin-left: -4px; margin-right: -4px;"></div>
                <div class="h-px bg-blue-200/60" style="margin-left: -4px; margin-right: -4px;"></div>
              </div>

              <!-- Erased area indicator -->
              <div class="mt-3 rounded-lg p-2 text-[10px] text-warm-500 flex items-center gap-1.5" style="background: rgba(232,112,74,0.06); border: 1px dashed rgba(232,112,74,0.3);">
                <svg class="w-3 h-3 text-milo-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
                Milo noticed you erased that…
              </div>
            </div>
          </div>

          <!-- Milo hint bubble — floating above notebook -->
          <div
            class="absolute -top-10 -right-4 sm:-right-8 max-w-[180px] rounded-2xl px-3 py-2.5 shadow-lg z-10"
            style="
              background: #E8704A;
              animation: hint-bubble-in 0.8s ease-out 0.3s both, float-up-down 5s ease-in-out 1s infinite;
            "
          >
            <p class="text-white text-[10px] leading-relaxed font-medium">
              What does Newton's second law tell us about force and acceleration?
            </p>
            <!-- Bubble tail pointing down to notebook -->
            <div class="absolute bottom-0 left-4 translate-y-full w-0 h-0" style="border-left: 6px solid transparent; border-right: 6px solid transparent; border-top: 6px solid #E8704A;"></div>
          </div>

          <!-- Glow ring around notebook -->
          <div
            class="absolute inset-0 rounded-3xl pointer-events-none -z-10"
            style="animation: notebook-glow 4s ease-in-out infinite; border-radius: 24px;"
          ></div>

          <!-- Mac camera indicator (small, bottom right) -->
          <div class="absolute -bottom-4 -right-4 sm:-right-6 bg-white dark:bg-warm-800 rounded-2xl px-3 py-2 shadow-md border border-warm-200 dark:border-warm-700 flex items-center gap-2">
            <div class="w-10 h-7 rounded-md border-2 border-warm-300 dark:border-warm-600 flex items-center justify-center">
              <div class="w-1.5 h-1.5 rounded-full bg-sage-400"></div>
            </div>
            <div>
              <div class="text-[10px] font-semibold text-warm-800 dark:text-cream-100">Desk View</div>
              <div class="text-[9px] text-sage-500 font-medium">● Live</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
