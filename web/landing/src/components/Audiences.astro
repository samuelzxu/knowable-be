---
// Audiences — tabbed section for Parents, Teachers, Students
---

<section id="for-you" class="py-20 sm:py-28 bg-cream-50 dark:bg-warm-900">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12 reveal">
      <p class="section-label">
        <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 12 12"><circle cx="6" cy="6" r="6"/></svg>
        For everyone involved
      </p>
      <h2 class="font-display text-4xl sm:text-5xl text-warm-900 dark:text-cream-50 mb-4">
        Knowable works for <em class="text-milo-400 not-italic">you</em>
      </h2>
      <p class="text-lg text-warm-500 dark:text-warm-400 max-w-xl mx-auto">
        Whether you're the one studying, the one paying for tutors, or the one teaching — Milo has something to offer.
      </p>
    </div>

    <!-- Tab buttons -->
    <div class="flex justify-center mb-10 reveal">
      <div class="inline-flex bg-cream-200 dark:bg-warm-800 rounded-2xl p-1.5 gap-1">
        {[
          { id: "students", label: "Students", emoji: "✏️" },
          { id: "parents", label: "Parents", emoji: "👨‍👩‍👧" },
          { id: "teachers", label: "Teachers", emoji: "🎓" },
        ].map(({ id, label, emoji }, i) => (
          <button
            data-tab={id}
            class={`audience-tab px-5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 ${i === 0 ? "bg-white dark:bg-warm-700 text-warm-900 dark:text-cream-100 shadow-sm" : "text-warm-500 dark:text-warm-400 hover:text-warm-700 dark:hover:text-warm-200"}`}
            aria-selected={i === 0 ? "true" : "false"}
          >
            <span class="mr-1.5">{emoji}</span>{label}
          </button>
        ))}
      </div>
    </div>

    <!-- Tab panels -->
    <div class="reveal reveal-delay-1">

      <!-- Students panel -->
      <div id="panel-students" class="audience-panel grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h3 class="font-display text-3xl sm:text-4xl text-warm-900 dark:text-cream-50 mb-5 leading-tight">
            Like having your smartest friend<br />
            <em class="text-milo-400 not-italic">in the room with you</em>
          </h3>
          <p class="text-warm-600 dark:text-warm-400 leading-relaxed mb-6 text-lg">
            Milo never makes you feel dumb for asking. No judgment, no impatience, no "just look it up." It sees your actual work and asks exactly the right question to unstick you — so you get the satisfaction of figuring it out yourself.
          </p>
          <div class="space-y-4">
            {[
              { title: "Available at midnight before the exam", body: "No scheduling, no hourly rate. Milo is there whenever you are." },
              { title: "Builds real understanding", body: "Because Milo guides you to the answer, it actually sticks. Not just memorized steps." },
              { title: "Speaks in your language", body: "Warm, encouraging, slightly playful. Not a robot reciting formulas." },
            ].map(({ title, body }) => (
              <div class="flex gap-4">
                <div class="w-8 h-8 rounded-xl bg-milo-50 dark:bg-milo-900/30 border border-milo-200 dark:border-milo-800 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4 text-milo-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-warm-800 dark:text-cream-100 mb-0.5">{title}</div>
                  <div class="text-sm text-warm-500 dark:text-warm-400">{body}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <!-- Student illustration -->
        <div class="relative flex justify-center" aria-hidden="true">
          <div class="w-72 rounded-3xl bg-cream-100 dark:bg-warm-800 border border-warm-200 dark:border-warm-700 p-6 shadow-lg">
            <!-- Night study vibe -->
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs text-warm-400 dark:text-warm-500">11:47 PM · Physics</span>
              <span class="text-xs bg-milo-50 dark:bg-milo-900/30 text-milo-500 px-2 py-0.5 rounded-full border border-milo-200 dark:border-milo-800">Session active</span>
            </div>
            <div class="space-y-3">
              <div class="bg-white dark:bg-warm-900 rounded-2xl p-4 border border-warm-200 dark:border-warm-700">
                <div style="font-family: Georgia, serif; font-size: 12px;" class="text-warm-700 dark:text-warm-300 mb-3">
                  Problem 7: A ball is thrown upward at 15 m/s...
                </div>
                <div class="h-px bg-warm-100 dark:bg-warm-700 my-2"></div>
                <div style="font-family: Georgia, serif; font-size: 11px;" class="text-warm-500 dark:text-warm-400">
                  t = v/g = 15/9.8 ≈ <span class="text-warm-300 dark:text-warm-600">???</span>
                </div>
              </div>
              <div class="bg-milo-400 rounded-2xl rounded-br-sm p-3 shadow-sm">
                <p class="text-white text-xs leading-relaxed">
                  You're on the right track! What does it mean physically when the velocity equals zero?
                </p>
              </div>
              <div class="flex items-center gap-2">
                <img src="/favicon.svg" alt="Milo" width="24" height="24" class="rounded-full" />
                <span class="text-[10px] text-warm-400 dark:text-warm-500">Milo · just now</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Parents panel (hidden) -->
      <div id="panel-parents" class="audience-panel hidden grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h3 class="font-display text-3xl sm:text-4xl text-warm-900 dark:text-cream-50 mb-5 leading-tight">
            The $80/hr tutor,<br />
            <em class="text-milo-400 not-italic">without the $80/hr</em>
          </h3>
          <p class="text-warm-600 dark:text-warm-400 leading-relaxed mb-6 text-lg">
            You want your child to succeed. You also don't want to spend thousands on tutoring every semester. Knowable gives them patient, personalized coaching available 24/7 — and you get the progress reports to actually see it working.
          </p>
          <div class="space-y-4">
            {[
              { title: "See real progress, not just grades", body: "Track which topics needed the most help and how improvement happened over time." },
              { title: "Confidence without dependence", body: "Milo teaches your child to think, not to rely on having answers handed to them." },
              { title: "Safe and private", body: "No video stored, no audio recorded. We built this for parents who ask hard questions about privacy." },
            ].map(({ title, body }) => (
              <div class="flex gap-4">
                <div class="w-8 h-8 rounded-xl bg-sage-50 dark:bg-sage-900/20 border border-sage-200 dark:border-sage-800 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4 text-sage-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-warm-800 dark:text-cream-100 mb-0.5">{title}</div>
                  <div class="text-sm text-warm-500 dark:text-warm-400">{body}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <!-- Parent illustration: progress view -->
        <div class="relative flex justify-center" aria-hidden="true">
          <div class="w-72 rounded-3xl bg-cream-100 dark:bg-warm-800 border border-warm-200 dark:border-warm-700 p-6 shadow-lg">
            <div class="flex items-center justify-between mb-4">
              <span class="text-sm font-semibold text-warm-800 dark:text-cream-100">Alex's progress</span>
              <span class="text-xs text-warm-400">This month</span>
            </div>
            <div class="space-y-3">
              {[
                { topic: "Kinematics", pct: 85, color: "#E8704A" },
                { topic: "Newton's Laws", pct: 72, color: "#5fa07c" },
                { topic: "Energy & Work", pct: 60, color: "#E8704A" },
                { topic: "Waves", pct: 45, color: "#f0a383" },
              ].map(({ topic, pct, color }) => (
                <div>
                  <div class="flex justify-between text-xs mb-1">
                    <span class="text-warm-700 dark:text-warm-300 font-medium">{topic}</span>
                    <span class="text-warm-400">{pct}%</span>
                  </div>
                  <div class="h-2 rounded-full bg-warm-200 dark:bg-warm-700 overflow-hidden">
                    <div class="h-full rounded-full transition-all" style={`width: ${pct}%; background: ${color};`}></div>
                  </div>
                </div>
              ))}
            </div>
            <div class="mt-4 pt-3 border-t border-warm-200 dark:border-warm-700 flex items-center gap-2">
              <svg class="w-4 h-4 text-sage-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
              <span class="text-xs text-warm-500 dark:text-warm-400">Up 18% since last month</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Teachers panel (hidden) -->
      <div id="panel-teachers" class="audience-panel hidden grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h3 class="font-display text-3xl sm:text-4xl text-warm-900 dark:text-cream-50 mb-5 leading-tight">
            Students who arrive<br />
            <em class="text-milo-400 not-italic">actually prepared</em>
          </h3>
          <p class="text-warm-600 dark:text-warm-400 leading-relaxed mb-6 text-lg">
            Knowable reinforces what you teach — it doesn't replace you. Milo's hints are Socratic, designed to guide students to understanding rather than short-circuit the learning process. Your students come to class with fewer gaps and more confidence.
          </p>
          <div class="space-y-4">
            {[
              { title: "Aligned to what you teach", body: "Students practice the exact methods you cover. No contradictory approaches or shortcuts." },
              { title: "Surfaces the real gaps", body: "Progress data shows which concepts students struggled with before class, so you can address them." },
              { title: "Builds independent thinkers", body: "Socratic-method coaching means students learn to work through problems, not just get answers." },
            ].map(({ title, body }) => (
              <div class="flex gap-4">
                <div class="w-8 h-8 rounded-xl bg-cream-200 dark:bg-warm-700 border border-warm-200 dark:border-warm-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4 text-warm-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
                </div>
                <div>
                  <div class="text-sm font-semibold text-warm-800 dark:text-cream-100 mb-0.5">{title}</div>
                  <div class="text-sm text-warm-500 dark:text-warm-400">{body}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
        <!-- Teacher illustration: class overview -->
        <div class="relative flex justify-center" aria-hidden="true">
          <div class="w-72 rounded-3xl bg-cream-100 dark:bg-warm-800 border border-warm-200 dark:border-warm-700 p-6 shadow-lg">
            <div class="flex items-center justify-between mb-4">
              <span class="text-sm font-semibold text-warm-800 dark:text-cream-100">Class 11B · Physics</span>
              <span class="text-xs text-sage-500 font-medium">8 students using Knowable</span>
            </div>
            <div class="text-xs text-warm-500 dark:text-warm-400 mb-3">Common struggle points this week:</div>
            <div class="space-y-2">
              {[
                { concept: "Free body diagrams", count: 6 },
                { concept: "Unit conversion", count: 5 },
                { concept: "Vector components", count: 4 },
              ].map(({ concept, count }) => (
                <div class="flex items-center justify-between bg-white dark:bg-warm-900 rounded-xl px-4 py-2.5 border border-warm-200 dark:border-warm-700">
                  <span class="text-xs text-warm-700 dark:text-warm-300">{concept}</span>
                  <span class="text-xs font-semibold text-milo-500">{count} students</span>
                </div>
              ))}
            </div>
            <div class="mt-4 text-xs text-center text-warm-400 dark:text-warm-500">
              → Consider a quick review at the start of Monday's class
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>(".audience-tab");
  const panels = document.querySelectorAll<HTMLElement>(".audience-panel");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.dataset.tab;

      // Update tab styles
      tabs.forEach((t) => {
        const isActive = t.dataset.tab === target;
        t.classList.toggle("bg-white", isActive);
        t.classList.toggle("dark:bg-warm-700", isActive);
        t.classList.toggle("text-warm-900", isActive);
        t.classList.toggle("dark:text-cream-100", isActive);
        t.classList.toggle("shadow-sm", isActive);
        t.classList.toggle("text-warm-500", !isActive);
        t.classList.toggle("dark:text-warm-400", !isActive);
        t.setAttribute("aria-selected", isActive ? "true" : "false");
      });

      // Show/hide panels
      panels.forEach((panel) => {
        panel.classList.toggle("hidden", panel.id !== `panel-${target}`);
      });
    });
  });
</script>
