---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SocialProof from "../components/SocialProof.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Features from "../components/Features.astro";
import Audiences from "../components/Audiences.astro";
import FAQ from "../components/FAQ.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Knowable — The AI coach that practices with you"
  description="Knowable uses macOS Desk View to coach you through math and physics problems in real time. Meet Milo — your AI tutor."
>
  <Hero />
  <SocialProof />
  <HowItWorks />
  <Features />
  <Audiences />

  <!-- Waitlist CTA section -->
  <section id="waitlist" class="py-20 sm:py-28 bg-cream-50 dark:bg-warm-900 relative overflow-hidden">
    <!-- Subtle background -->
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] rounded-full opacity-10"
        style="background: radial-gradient(ellipse, #E8704A 0%, transparent 70%);"></div>
    </div>

    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <p class="section-label justify-center">
          <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 12 12"><circle cx="6" cy="6" r="6"/></svg>
          Limited early access
        </p>
        <h2 class="font-display text-4xl sm:text-5xl text-warm-900 dark:text-cream-50 mb-5">
          Be the first to meet Milo
        </h2>
        <p class="text-lg text-warm-500 dark:text-warm-400 max-w-lg mx-auto leading-relaxed">
          Knowable is in early development. Join the waitlist and we'll reach out when it's ready — plus get a founding-member discount.
        </p>
      </div>

      <!-- Form card -->
      <div class="reveal reveal-delay-1 bg-white dark:bg-warm-800 rounded-3xl border border-warm-200 dark:border-warm-700 shadow-xl p-8 sm:p-10">
        <WaitlistForm />

        <p class="text-xs text-warm-400 dark:text-warm-600 text-center mt-5 leading-relaxed">
          No spam, ever. Just one email when Knowable is ready for you.<br />
          Unsubscribe any time.
        </p>
      </div>

      <!-- Social reassurance -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-6 text-sm text-warm-400 dark:text-warm-500 reveal reveal-delay-2">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-sage-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
          200+ already waiting
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-sage-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd"/></svg>
          Privacy protected
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-sage-400" fill="currentColor" viewBox="0 0 20 20"><path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/></svg>
          We'll only contact you once
        </span>
      </div>
    </div>
  </section>

  <FAQ />

  <Footer slot="footer" />
</BaseLayout>
