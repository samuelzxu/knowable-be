{
  "name": "knowable-be",
  "version": "1.0.0",
  "private": true,
  "description": "Knowable backend Lambda handlers",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "node package-lambdas.mjs",
    "build:lambdas": "npm run build && npm run package",
    "test": "vitest run",
    "dev": "tsx src/local/server.ts",
    "seed-demo": "tsx scripts/seed-demo.ts",
    "create-invite": "tsx scripts/create-invite.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:seed": "tsc --noEmit --project scripts/tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.758.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.758.0",
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/client-secrets-manager": "^3.758.0",
    "@aws-sdk/lib-dynamodb": "^3.758.0",
    "aws-jwt-verify": "^4.0.1",
    "express": "^4.21.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/aws-lambda": "^8.10.161",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vitest/coverage-v8": "^3.0.8",
    "adm-zip": "^0.5.17",
    "esbuild": "^0.25.1",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
